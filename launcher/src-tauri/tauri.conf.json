{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HKSS Launcher",
  "version": "0.1.21",
  "identifier": "io.github.decryptu.hkss",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "HKSS Launcher", "width": 900, "height": 720, "minWidth": 640, "minHeight": 560, "backgroundColor": "#040406" },
      { "label": "cover", "title": "HKSS Travel", "visible": false, "decorations": false, "resizable": false, "skipTaskbar": true, "alwaysOnTop": true, "focus": false, "shadow": false, "backgroundColor": "#040406" }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Decryptu",
    "shortDescription": "Hollow Knight x Silksong combo randomizer",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
