<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Games.props" />
  <PropertyGroup>
    <GameManaged>$(HollowKnightManaged)</GameManaged>
    <RootNamespace>ItemChanger</RootNamespace>
    <AssemblyName>HKSS.HollowKnight.ItemChanger</AssemblyName>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1701;1702;CS1591;IDE0018;CS0618;CS8632;CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Using Remove="System.Threading" />
    <Using Remove="System.Threading.Tasks" />
    <Using Include="ItemChanger.LogHelper" Static="true" />
    <Using Include="UnityEngine" />
    <Using Include="UnityEngine.Object" Alias="UObject" />
    <Using Include="UnityEngine.SceneManagement.Scene" Alias="Scene" />
    <Using Include="HutongGames.PlayMaker" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="**\*.png" />
    <None Remove="**\*.json" />
    <None Remove="**\*.xml" />
    <None Remove="**\*.wav" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.png" />
    <EmbeddedResource Include="Resources\**\*.json" />
    <EmbeddedResource Include="Resources\**\*.xml" />
    <EmbeddedResource Include="Resources\**\*.wav" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HKSS.HollowKnight.ModApi\HKSS.HollowKnight.ModApi.csproj" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCore)\Mono.Cecil.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(BepInExCore)\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(BepInExCore)\MonoMod.Utils.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="PlayMaker" HintPath="$(GameManaged)\PlayMaker.dll" Private="false" />
    <Reference Include="TeamCherry.Localization" HintPath="$(GameManaged)\TeamCherry.Localization.dll" Private="false" />
    <Reference Include="TeamCherry.TK2D" HintPath="$(GameManaged)\TeamCherry.TK2D.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameManaged)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManaged)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(GameManaged)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GameManaged)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GameManaged)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>
</Project>
